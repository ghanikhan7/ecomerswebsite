# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Razorpay Test Mode Credentials
# Generate these in Razorpay Dashboard > Settings > API Keys (in Test Mode)
# Documentation: https://razorpay.com/docs/payments/dashboard/account-settings/api-keys/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional: Razorpay Webhook Secret (for async webhook notifications)
# Set in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
